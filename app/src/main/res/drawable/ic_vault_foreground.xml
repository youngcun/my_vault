<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标：盾牌 + 钥匙孔，纯矢量、无位图资源。
  矢量图标体积小且在任何 DPI 下都清晰，也避免在 APK 里留下
  可被用于指纹识别的位图元数据。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 盾牌外形 -->
    <path
        android:fillColor="#1F6F5C"
        android:pathData="M54,20 L82,30 L82,54 C82,70 70,84 54,90 C38,84 26,70 26,54 L26,30 Z" />

    <!-- 钥匙孔：圆头 + 梯形下摆，象征「只有一把钥匙」 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,38 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,44 L58,44 L61,64 L47,64 Z" />
</vector>
